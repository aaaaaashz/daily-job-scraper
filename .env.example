# PostgreSQL connection string. Never commit the populated .env file.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Supported sources: jobbank, indeed, kijiji, randstad
ENABLED_SOURCES=jobbank,indeed,kijiji,randstad

# Supported examples: Canada, British Columbia, BC, Vancouver, Vancouver, BC
TARGET_LOCATION=Canada

# Polite delay between pages from the same source.
REQUEST_DELAY_SECONDS=2
MAX_PAGES_PER_SEARCH=20

# HTTP reliability settings.
HTTP_TIMEOUT_SECONDS=30
HTTP_RETRIES=3
HTTP_BACKOFF_SECONDS=2

# Complete sources use the short grace period. Capped sources use the longer one.
STALE_AFTER_DAYS=2
INCOMPLETE_SOURCE_STALE_AFTER_DAYS=14

# Maximum error records stored on one run.
MAX_ERROR_DETAILS=100

# Optional Slack or Discord webhook.
ALERT_WEBHOOK_URL=
